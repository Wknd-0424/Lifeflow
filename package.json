{
  "name": "lifeflow-blood-bank",
  "version": "1.0.0",
  "private": true,
  "description": "B.Tech Web Technology lab project — Online Blood Bank Inventory Management System",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "postinstall": "node scripts/prepare-browser-assets.cjs && npm run build:glass",
    "build:glass": "esbuild liquid-glass=components/liquid-glass-entry.tsx dashboard-liquid-glass=components/dashboard-liquid-glass.tsx --bundle --splitting --minify --jsx=automatic --format=esm --outdir=public/vendor --chunk-names=liquid-glass-shared && tailwindcss -i components/liquid-glass.css -o public/vendor/liquid-glass.css --minify",
    "typecheck:glass": "tsc --noEmit --strict --allowJs --jsx react-jsx --module esnext --moduleResolution bundler --target es2022 components/liquid-glass-entry.tsx components/dashboard-liquid-glass.tsx"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "clsx": "^2.1.1",
    "motion": "^14.12.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  }
}
