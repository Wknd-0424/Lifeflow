{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run postinstall && npm test",
  "outputDirectory": "public",
  "rewrites": [{"source":"/api/:path*","destination":"/api?route=:path*"}],
  "headers": [{"source":"/(.*)","headers":[
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"Content-Security-Policy","value":"default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' data: blob:; frame-ancestors 'none'; form-action 'self'"}
  ]}]
}
